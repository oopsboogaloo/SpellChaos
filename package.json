{
  "name": "spell-chaos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --testTimeout=30000",
    "check": "pnpm typecheck && pnpm test",
    "build": "tsc -p tsconfig.build.json && vite build apps/web --base=/SpellChaos/ --outDir ../../dist/web",
    "dev": "vite apps/web",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "3.2.4",
    "fast-check": "4.3.0",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  }
}
